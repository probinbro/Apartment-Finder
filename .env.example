# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=your-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production when served over HTTPS, e.g. https://apartments.example.com
CSRF_TRUSTED_ORIGINS=
# Public URL of the site (used in Supabase email-confirmation links)
SITE_URL=http://127.0.0.1:8000
SITE_NAME=Apartment Finder
CURRENCY_SYMBOL=$
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# Dashboard -> Connect -> "Transaction pooler" connection string (port 6543,
# IPv4 compatible). URL-encode special characters in the password (@ -> %40).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Supabase API (Dashboard -> Project Settings -> API)
# SUPABASE_SERVICE_ROLE_KEY is server-side only. NEVER expose it to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=apartment-media

# Optional tuning
IMAGE_MAX_UPLOAD_MB=5
SESSION_COOKIE_AGE=604800

# Comma-separated social login providers you enabled in Supabase, e.g. google
SUPABASE_OAUTH_PROVIDERS=

# ---------------------------------------------------------------------------
# Booking emails (landlord notifications)
# Option A (recommended, works on Render free): Brevo — https://app.brevo.com
#   SMTP & API -> API keys -> create key. Verify DEFAULT_FROM_EMAIL as a sender.
# Option B: SMTP, e.g. Gmail with an App Password (EMAIL_HOST=smtp.gmail.com).
# Neither set: emails are printed to the console (development).
# ---------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=Apartment Finder <your-verified-sender@gmail.com>
BREVO_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Who gets booking emails for listings without a landlord account (comma-separated)
ADMIN_NOTIFICATION_EMAILS=

# Bookings
BOOKING_HOLD_DAYS=3
MAX_ACTIVE_BOOKINGS_PER_USER=3
TIME_ZONE=Asia/Dhaka
CURRENCY_SYMBOL=৳
