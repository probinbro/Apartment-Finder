# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=your-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production when served over HTTPS, e.g. https://apartments.example.com
CSRF_TRUSTED_ORIGINS=
# Public URL of the site (used in Supabase email-confirmation links)
SITE_URL=http://127.0.0.1:8000
SITE_NAME=Apartment Finder
CURRENCY_SYMBOL=$
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# Dashboard -> Connect -> "Transaction pooler" connection string (port 6543,
# IPv4 compatible). URL-encode special characters in the password (@ -> %40).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Supabase API (Dashboard -> Project Settings -> API)
# SUPABASE_SERVICE_ROLE_KEY is server-side only. NEVER expose it to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=apartment-media

# Optional tuning
IMAGE_MAX_UPLOAD_MB=5
SESSION_COOKIE_AGE=604800

# Comma-separated social login providers you enabled in Supabase, e.g. google
SUPABASE_OAUTH_PROVIDERS=
